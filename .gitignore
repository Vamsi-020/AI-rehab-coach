# ==============================================================================
# AI Rehabilitation Coach - Master .gitignore
# ==============================================================================

# --- Secrets, Credentials & Environment Configurations ---
# NEVER commit credentials, API keys, or database URIs!
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets.json
credentials.json

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
**/venv/
**/.venv/
**/env/
**/ENV/

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Code Quality ---
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# --- Node & Frontend (React/Vite) ---
node_modules/
**/node_modules/
frontend/dist/
**/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.vite/
**/.vite/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- IDEs & Editors ---
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# VS Code (preserve shared workspace settings & extensions, ignore personal/local state)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- AI & Tooling Scratch Artifacts ---
.kombai/
**/.kombai/

# --- Application Logs & Databases ---
*.log
logs/
**/logs/
*.sqlite3
*.db